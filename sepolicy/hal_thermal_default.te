# Read existing sensors. Mitigation remains with thermald and the kernel.
allow hal_thermal_default sysfs_thermal:dir r_dir_perms;
allow hal_thermal_default sysfs_thermal:file r_file_perms;
allow hal_thermal_default sysfs_batteryinfo:file r_file_perms;
# Restore sensing on the CPU channel after the legacy main-sensor reset.
allow hal_thermal_default sysfs_aries_cpu_sensor_mode:file rw_file_perms;
