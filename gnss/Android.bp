cc_binary {
    name: "android.hardware.gnss@1.0-service.aries",
    defaults: ["hidl_defaults"],
    vendor: true,
    compile_multilib: "32",
    relative_install_path: "hw",
    init_rc: ["android.hardware.gnss@1.0-service.aries.rc"],
    srcs: ["service.cpp"],
    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libhardware",
        "libbinder",
        "libhidlbase",
        "android.hardware.gnss@1.0",
    ],
}
