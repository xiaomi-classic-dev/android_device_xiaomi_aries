cc_binary {
    name: "android.hardware.thermal@2.0-service.aries",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["thermal.rc"],
    vintf_fragments: ["thermal-aries.xml"],
    srcs: ["Thermal.cpp"],
    shared_libs: ["libbase", "liblog", "libhidlbase", "libutils", "android.hardware.thermal@1.0", "android.hardware.thermal@2.0"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
