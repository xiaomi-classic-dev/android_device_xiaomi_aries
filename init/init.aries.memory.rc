# Real vmpressure and kill-event interfaces for the in-kernel LMK backend.
on init
    chown lmkd system /proc/lowmemorykiller
    chmod 0440 /proc/lowmemorykiller
    chown root system /dev/memcg/memory.pressure_level
    chmod 0040 /dev/memcg/memory.pressure_level
    chown root system /dev/memcg/cgroup.event_control
    chmod 0660 /dev/memcg/cgroup.event_control

# Keep cold anonymous pages in RAM instead of repeatedly evicting APK/code pages.
# Compression storage is allocated on demand; the device has 2 GiB physical RAM.
on post-fs-data
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
    # fs_mgr opens max_comp_streams read-only on this Android 14 baseline.
    # The legacy compressor selects its stream backend before disksize is set.
    # Use the single-stream backend: multi-stream swap stress panicked on Aries.
    write /sys/block/zram0/max_comp_streams 1
    swapon_all /vendor/etc/fstab.aries.zram
