From 494c8845648bb6cbea1493dfa4d899da032eb677 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Fri, 16 Oct 2026 15:15:17 +0800
Subject: [PATCH] bcmdhd: Register RTT v3 only with a compatible HAL table

The Android 15 port_docs baseline preserves the ultra-legacy wifi_hal_fn
ABI for existing vendor HAL binaries. That table has no 11az v3 entries,
but the newer Broadcom initializer registers both unconditionally.

Detect those table members at compile time and preserve the initialized
legacy RTT stubs when they are absent. Register the original v3 functions
with the newer table, without changing headers, table layout, driver
commands, scan/association paths or the existing RTT implementation.

Checked the extracted registration helper against the exact legacy and
pre-preservation headers: the legacy table and surrounding canaries stay
unchanged, and the modern table dispatches both v3 function pointers.

Change-Id: If622f72b30cc660729ecef5c01e48a40cabe023b
---
 bcmdhd/wifi_hal/wifi_hal.cpp | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/bcmdhd/wifi_hal/wifi_hal.cpp b/bcmdhd/wifi_hal/wifi_hal.cpp
index 99aad5f..7bb6955 100644
--- a/bcmdhd/wifi_hal/wifi_hal.cpp
+++ b/bcmdhd/wifi_hal/wifi_hal.cpp
@@ -255,6 +255,23 @@ static const char *IfaceTypeToString(wifi_interface_type iface_type)
     }
 }
 
+// Older vendor HAL ABIs omit the 11az entries. Keep their existing RTT
+// slots unchanged, while retaining v3 registration with the newer headers.
+template <typename HalFn>
+static auto initRttV3Funcs(HalFn *fn, int)
+        -> decltype(fn->wifi_rtt_range_request_v3 = wifi_rtt_range_request_v3,
+                    fn->wifi_get_rtt_capabilities_v3 = wifi_get_rtt_capabilities_v3,
+                    void())
+{
+    fn->wifi_rtt_range_request_v3 = wifi_rtt_range_request_v3;
+    fn->wifi_get_rtt_capabilities_v3 = wifi_get_rtt_capabilities_v3;
+}
+
+template <typename HalFn>
+static void initRttV3Funcs(HalFn *, long)
+{
+}
+
 /*initialize function pointer table with Broadcom HHAL API*/
 wifi_error init_wifi_vendor_hal_func_table(wifi_hal_fn *fn)
 {
@@ -282,9 +299,8 @@ wifi_error init_wifi_vendor_hal_func_table(wifi_hal_fn *fn)
     fn->wifi_set_link_stats = wifi_set_link_stats;
     fn->wifi_clear_link_stats = wifi_clear_link_stats;
     fn->wifi_get_valid_channels = wifi_get_valid_channels;
-    fn->wifi_rtt_range_request_v3 = wifi_rtt_range_request_v3;
+    initRttV3Funcs(fn, 0);
     fn->wifi_rtt_range_cancel = wifi_rtt_range_cancel;
-    fn->wifi_get_rtt_capabilities_v3 = wifi_get_rtt_capabilities_v3;
     fn->wifi_rtt_get_responder_info = wifi_rtt_get_responder_info;
     fn->wifi_enable_responder = wifi_enable_responder;
     fn->wifi_disable_responder = wifi_disable_responder;
