From c1878335d5177561d8b92356753e6858b9833ae4 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Fri, 16 Oct 2026 06:17:54 +0800
Subject: [PATCH] Bluetooth: Keep classic-only startup free of LE identity and
 scan commands

Adapt the MiOne guards to Android 15 GetController and profile callbacks. Report zero LE features, preserve classic link-key registration, and complete the startup synchronization callback without submitting unsupported LE Rand. This callback only orders stack startup; random-number generation APIs are unchanged.

Adapted-from: 19374b63b213b2807290d2c915e88fbd7f4a8e14

Adapted-from: f8d49ae546e72d7846294524c8fe910e3017a128

Adapted-from: b823053b6af7d0fe66d94d8b8bd1e912c9b1827d
Change-Id: I3063029f5b7e16e07e6ff7218dfb36296a2cd0b2
---
 system/bta/dm/bta_dm_act.cc  | 14 +++++++++++---
 system/btif/src/btif_core.cc |  9 ++++++++-
 system/stack/btm/btm_sec.cc  |  3 ++-
 3 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/system/bta/dm/bta_dm_act.cc b/system/bta/dm/bta_dm_act.cc
index 6b65525050..5cfb8fefdd 100644
--- a/system/bta/dm/bta_dm_act.cc
+++ b/system/bta/dm/bta_dm_act.cc
@@ -259,7 +259,7 @@ void BTA_dm_on_hw_on() {
   get_btm_client_interface().link_policy.BTM_WritePageTimeout(
           osi_property_get_int32(PROPERTY_PAGE_TIMEOUT, p_bta_dm_cfg->page_timeout));
 
-  if (ble_vnd_is_included()) {
+  if (bluetooth::shim::GetController()->SupportsBle() && ble_vnd_is_included()) {
     get_btm_client_interface().ble.BTM_BleReadControllerFeatures(
             bta_dm_ctrl_features_rd_cmpl_cback);
   } else {
@@ -276,10 +276,18 @@ void BTA_dm_on_hw_on() {
     }
   }
 
-  btm_ble_scanner_init();
+  if (bluetooth::shim::GetController()->SupportsBle()) {
+    btm_ble_scanner_init();
+  }
 
   // Synchronize with the controller before continuing
-  bta_dm_le_rand(get_main_thread()->BindOnce([](uint64_t /*value*/) { BTIF_dm_enable(); }));
+  auto on_controller_synced =
+          get_main_thread()->BindOnce([](uint64_t /*value*/) { BTIF_dm_enable(); });
+  if (bluetooth::shim::GetController()->SupportsBle()) {
+    bta_dm_le_rand(std::move(on_controller_synced));
+  } else {
+    std::move(on_controller_synced)(0);
+  }
 
   bta_sys_rm_register(bta_dm_rm_cback);
 
diff --git a/system/btif/src/btif_core.cc b/system/btif/src/btif_core.cc
index 30361defa2..ed69bdc5bd 100644
--- a/system/btif/src/btif_core.cc
+++ b/system/btif/src/btif_core.cc
@@ -427,7 +427,14 @@ void btif_get_adapter_property(bt_property_type_t type) {
   prop.len = sizeof(buf);
   if (prop.type == BT_PROPERTY_LOCAL_LE_FEATURES) {
     tBTM_BLE_VSC_CB cmn_vsc_cb;
-    bt_local_le_features_t local_le_features;
+    bt_local_le_features_t local_le_features = {};
+
+    if (!bluetooth::shim::GetController()->SupportsBle()) {
+      prop.len = sizeof(local_le_features);
+      memcpy(prop.val, &local_le_features, prop.len);
+      GetInterfaceToProfiles()->events->invoke_adapter_properties_cb(status, 1, &prop);
+      return;
+    }
 
     /* LE features are not stored in storage. Should be retrieved from stack
      */
diff --git a/system/stack/btm/btm_sec.cc b/system/stack/btm/btm_sec.cc
index 87e282b5e5..ac03eb7ad6 100644
--- a/system/stack/btm/btm_sec.cc
+++ b/system/stack/btm/btm_sec.cc
@@ -402,7 +402,8 @@ bool BTM_SecRegister(const tBTM_APPL_INFO* p_cb_info) {
     SMP_Register(btm_proc_smp_cback);
     Octet16 zero{0};
     /* if no IR is loaded, need to regenerate all the keys */
-    if (btm_sec_cb.devcb.id_keys.ir == zero) {
+    if (bluetooth::shim::GetController()->SupportsBle() &&
+        btm_sec_cb.devcb.id_keys.ir == zero) {
       btm_ble_reset_id();
     }
   } else {
