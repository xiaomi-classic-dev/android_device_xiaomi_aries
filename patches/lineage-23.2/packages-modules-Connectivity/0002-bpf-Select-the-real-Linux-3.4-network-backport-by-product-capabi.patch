From 288e45b1c5d1ec6d03f007b277c0940e43d7a8d9 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Sun, 18 Oct 2026 12:26:52 +0800
Subject: [PATCH] bpf: Select the real Linux 3.4 network backport by product
 capability

The Android 16 mainline metadata excluded every netd map and program on
the actual kernel, and BpfHandler still rejected it after loader admission.

Use the existing product opt-in, actual ARM32/kernel/device identity and
no version override. Declare true 3.4 program ranges for the implemented
relative skb/GSO/fullsock/LPM/socket backports, preserving Android 16 local
network protection, accounting and all 18 required netd programs. Keep ring
buffer and sk_storage requirements outside the backport.

Enable real map-info, program-info, lock, attach and query checks for this
profile. Keep the actual kernel version, verifier failures, completion
checks, default program sections and other products unchanged.

Validation: five BPF objects compile with and without the profile; default
runtime sections match the previous build. Loader and BpfHandler pass
actual ARM32 syntax checks. Required helpers/types and map relocations
were audited against both kernels. No Android 16 runtime test performed.

Change-Id: Ic4a40f552b0d505501cf1d09e2e5c4e5e341755e
---
 bpf/headers/include/bpf/KernelUtils.h | 19 +++++++
 bpf/loader/NetBpfLoad.cpp             | 25 +++------
 bpf/netd/Android.bp                   |  2 +-
 bpf/netd/BpfHandler.cpp               | 23 ++++----
 bpf/progs/Android.bp                  | 23 ++++++++
 bpf/progs/clatd.c                     | 12 +++++
 bpf/progs/include/bpf_helpers.h       | 22 ++++++--
 bpf/progs/netd.c                      | 75 +++++++++++++++++++++------
 8 files changed, 150 insertions(+), 51 deletions(-)

diff --git a/bpf/headers/include/bpf/KernelUtils.h b/bpf/headers/include/bpf/KernelUtils.h
index 970a32938f..93315e94d4 100644
--- a/bpf/headers/include/bpf/KernelUtils.h
+++ b/bpf/headers/include/bpf/KernelUtils.h
@@ -192,6 +192,25 @@ static constexpr bool isArm() {
 #endif
 }
 
+// Only the two opted-in ARM32 products ship this audited Linux 3.4 BPF
+// backport.  Capability selection does not change kernelVer or any KVER value.
+static inline bool hasLegacyBpfBackport() {
+#if defined(NETBPFLOAD_LEGACY_BACKPORT)
+    char device[PROP_VALUE_MAX] = {};
+    char allow[PROP_VALUE_MAX] = {};
+    char overrideVersion[PROP_VALUE_MAX] = {};
+    __system_property_get("ro.product.device", device);
+    __system_property_get("ro.bpf.allow_32bit", allow);
+    if (__system_property_get("ro.bpf.kver_override", overrideVersion)) return false;
+    return isArm() && isUserspace32bit() && isKernel32Bit() &&
+           kernelVer >= KVER(3, 4, 0) && kernelVer < KVER(3, 5, 0) &&
+           !strcmp(allow, "true") &&
+           (!strcmp(device, "aries") || !strcmp(device, "mione_plus"));
+#else
+    return false;
+#endif
+}
+
 static constexpr bool isX86() {
 #if defined(__i386__)
     static_assert(isUserspace32bit(), "huh? i386 must be 32 bit");
diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
