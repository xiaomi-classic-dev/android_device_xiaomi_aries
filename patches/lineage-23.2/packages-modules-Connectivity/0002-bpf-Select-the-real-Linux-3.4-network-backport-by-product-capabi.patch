 }
 
-// These two ARM32 products carry the real Linux 3.4 BPF backport.  Keep
-// kernelVersion() unchanged so ELF program selection and map sanitization use
-// the real kernel.  This only admits them to the loader; all BPF syscalls,
-// verifier failures, required maps/programs and final completion remain fatal.
-static bool allowLegacyBpfBackport() {
-#if defined(NETBPFLOAD_LEGACY_BACKPORT)
-    const auto device = android::base::GetProperty("ro.product.device", "");
-    return allow32BitKernel() && isKernelVersion(3, 4) &&
-           (device == "aries" || device == "mione_plus");
-#else
-    return false;
-#endif
-}
-
 // This verifies the macro and the C++ api are in sync, and that they're compile time known.
 constexpr auto useLibBpf = COM_ANDROID_TETHERING_READONLY_FLAGS_USE_LIBBPF;
 static_assert(std::is_same<decltype(useLibBpf), const bool>::value, "useLibBpf must be a boolean.");
@@ -481,7 +467,7 @@ static bool mapMatchesExpectations(const unique_fd& fd,
     // This is because the primary failure mode we're trying to detect here
     // is either a source code misconfiguration (which is likely kernel independent)
     // or a newly introduced kernel feature/bug (which is unlikely to get backported to 4.9).
-    if (!isAtLeastKernelVersion(4, 14)) return true;
+    if (!isAtLeastKernelVersion(4, 14) && !android::bpf::hasLegacyBpfBackport()) return true;
 
     // Assuming fd is a valid Bpf Map file descriptor then
     // all the following should always succeed on a 4.14+ kernel.
@@ -795,7 +781,7 @@ static int pinMap(const borrowed_fd& fd, const struct bpf_map_def& mapDef) {
             return -err;
         }
 
-        if (isAtLeastKernelVersion(4, 14)) {
+        if (isAtLeastKernelVersion(4, 14) || android::bpf::hasLegacyBpfBackport()) {
             int mapId = bpfGetFdMapId(fd);
             if (mapId == -1) {
                 const int err = errno;
@@ -808,7 +794,8 @@ static int pinMap(const borrowed_fd& fd, const struct bpf_map_def& mapDef) {
 }
 
 static bool isMapTypeSupported(enum bpf_map_type type) {
-    if (type == BPF_MAP_TYPE_LPM_TRIE && !isAtLeastKernelVersion(4, 14)) {
+    if (type == BPF_MAP_TYPE_LPM_TRIE && !isAtLeastKernelVersion(4, 14) &&
+        !android::bpf::hasLegacyBpfBackport()) {
         // On Linux Kernels older than 4.14 this map type doesn't exist - autoskip.
         return false;
     }
@@ -1053,7 +1040,7 @@ static int pinProg(const borrowed_fd& fd, const struct bpf_prog_def& progDef) {
 }
 
 static int validateProg(const borrowed_fd& fd, const char* const progPinLoc) {
-    if (!isAtLeastKernelVersion(4, 14)) {
+    if (!isAtLeastKernelVersion(4, 14) && !android::bpf::hasLegacyBpfBackport()) {
         return 0;
     }
     int progId = bpfGetFdProgId(fd);
@@ -1628,7 +1615,7 @@ static int doLoad(char** argv, char * const envp[]) {
 
     logTetheringApexVersion();
 
-    const bool legacyBpfBackport = allowLegacyBpfBackport();
+    const bool legacyBpfBackport = android::bpf::hasLegacyBpfBackport();
     if (legacyBpfBackport) {
         ALOGW("Loading BPF on the opted-in Linux 3.4 backport; real kernel version %07x.",
               kernelVersion());
