diff --git a/bpf/headers/include/bpf/KernelUtils.h b/bpf/headers/include/bpf/KernelUtils.h
index 1ee34f056f..24d44564ab 100644
--- a/bpf/headers/include/bpf/KernelUtils.h
+++ b/bpf/headers/include/bpf/KernelUtils.h
@@ -53,7 +53,9 @@ static inline unsigned __unused kernelVersion() {
 #endif
 
 static constexpr unsigned minSupportedKernelVer =
-#ifdef __ANDROID_APEX__  // Mainline code (incl. NetBpfLoad) in APEX shouldn't (yet) assume anything
+#if defined(NETBPFLOAD_LEGACY_BACKPORT) // Probe real capabilities on these product builds.
+        KVER(0, 0, 0);
+#elif defined(__ANDROID_APEX__)  // Mainline code must not assume a minimum kernel.
         KVER(0, 0, 0);
 #elif __ANDROID_API__ >= 10000 // tip of dev tree - we'll need to bump this manually as time advances
         KVER(5, 10, 0);
@@ -199,6 +201,26 @@ static constexpr bool isArm() {
 #endif
 }
 
+// The opted-in Aries/MiOne ARM32 kernels carry the audited network, BTF,
+// mmapable-array, LRU, socket-storage and ring-buffer backports. This selects
+// capabilities, never a newer kernel version. Keep all actual syscall checks.
+static inline bool hasLegacyBpfBackport() {
+#if defined(NETBPFLOAD_LEGACY_BACKPORT)
+    char device[PROP_VALUE_MAX] = {};
+    char allow[PROP_VALUE_MAX] = {};
+    char overrideVersion[PROP_VALUE_MAX] = {};
+    __system_property_get("ro.product.device", device);
+    __system_property_get("ro.bpf.allow_32bit", allow);
+    if (__system_property_get("ro.bpf.kver_override", overrideVersion)) return false;
+    return isArm() && isUserspace32bit() && isKernel32Bit() &&
+           kernelVer >= KVER(3, 4, 0) && kernelVer < KVER(3, 5, 0) &&
+           !strcmp(allow, "true") &&
+           (!strcmp(device, "aries") || !strcmp(device, "mione_plus"));
+#else
+    return false;
+#endif
+}
+
 static constexpr bool isX86() {
 #if defined(__i386__)
     static_assert(isUserspace32bit(), "huh? i386 must be 32 bit");
